{
  "manifest_version": 3,
  "name": "Lyue",
  "version": "1.0.0",
  "description": "在已登录的复旦 iCourse 页面中自动查找直播与录播，提供字幕和可选降噪。",
  "content_scripts": [
    {
      "matches": [
        "https://icourse.fudan.edu.cn/*",
        "https://webvpn.fudan.edu.cn/https/77726476706e69737468656265737421f9f44e8935236d1e781d8dad961b2631a501f26f/*"
      ],
      "js": [
        "vendor/crypto-js.js",
        "vendor/hls.min.js",
        "core.js",
        "qwen-cache.js",
        "content.js"
      ],
      "css": [
        "player.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "启用／停止当前课程的人声增强",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8768/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "version_name": "Lyue 1.0.0"
}
